{
    "name": "estouai/weave",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Estouai\\Weave\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Estouai\\Weave\\Tests\\": "tests"
        }
    },
    "require": {
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "scripts": {
        "pint": "pint",
        "lint": "pint --test",
        "format": "@pint",
        "pest": "pest",
        "test": "@pest"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Weave",
            "description": "Weave addon"
        },
        "laravel": {
            "providers": [
                "Estouai\\Weave\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
